# Do NOT set NODE_ENV here. Next.js manages it (dev vs build).
# NODE_ENV=development in .env breaks `next build` on /_global-error (Next 16).

# Restaurant API (all endpoints are under /api)
NEXT_PUBLIC_API_URL=https://restaurant.digitallisbon.pt/api
NEXT_PUBLIC_RESTAURANT_ID1=2
NEXT_PUBLIC_RESTAURANT_ID2=3
NEXT_PUBLIC_RESTAURANT_ID3=4
NEXT_PUBLIC_RESTAURANT_NAME_PREFIX=Grill N Chill
NEXT_PUBLIC_RESTAURANT_NAME=Grill N Chill
NEXT_PUBLIC_SITE_URL=https://grillnchill.pt

# Google Place IDs — bootstrap only (Settings → Opening hours saves into website_content).
# Live reviews prefer Laravel POST /restaurants/{id}/google-place
# (GOOGLE_PLACES_API_KEY and GEMINI_API_KEY live on the Laravel server).
# Optional Next bootstrap key (only until Place IDs are saved in Settings):
# GOOGLE_PLACES_API_KEY=
# 1 = Praça do Chile, 2 = Intendente, 3 = Bakery
GOOGLE_PLACE_ID=ChIJWevl6GszGQ0Ru8Hof8RpgyY
GOOGLE_PLACE_ID1=ChIJWevl6GszGQ0Ru8Hof8RpgyY
GOOGLE_PLACE_ID2=ChIJGYqMzoczGQ0RLqIohQ-erZI
GOOGLE_PLACE_ID3=ChIJ9fxyCgAzGQ0REy8TrHCz_2Y

# Optional public theme fallbacks (Owner → Settings → Theme overrides these)
# NEXT_PUBLIC_THEME_ACCENT=#c59d5f
# NEXT_PUBLIC_THEME_BACKGROUND=#241e19
# NEXT_PUBLIC_THEME_FOREGROUND=#f5f0e8
# NEXT_PUBLIC_THEME_FONT_PAIR=playfair-montserrat

# Optional display names / addresses (fallbacks when API is empty)
NEXT_PUBLIC_RESTAURANT_DISPLAY_NAME1=GRILL N CHILL Restaurant
NEXT_PUBLIC_RESTAURANT_ADDRESS1=Praça do Chile 6, 1000-098 Lisboa, Portugal
NEXT_PUBLIC_RESTAURANT_DISPLAY_NAME2=Grill N Chill INTENDENTE
NEXT_PUBLIC_RESTAURANT_ADDRESS2=Av. Alm. Reis 27, 1150-008 Lisboa, Portugal
NEXT_PUBLIC_RESTAURANT_DISPLAY_NAME3=The Bakery Cafe by Grill n Chill
NEXT_PUBLIC_RESTAURANT_ADDRESS3=Praça do Chile 9, 1900-122 Lisboa, Portugal

# Optional legacy fallback if cake menu extraction fails (prefer live menu flavours)
# NEXT_PUBLIC_BAKERY_CUSTOM_CAKE_ITEM_ID=

# Google OAuth (set real values locally)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://grillnchill.pt
NEXT_PUBLIC_LARAVEL_URL=https://restaurant.digitallisbon.pt

NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=eu

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only — never use NEXT_PUBLIC_ for Stripe secret
STRIPE_SECRET_KEY=

NEXT_PUBLIC_HERO_HEADLINE=Grill. Chill. Enjoy.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
